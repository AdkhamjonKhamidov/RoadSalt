# RoadSalt environment template.
# Copy to .env.local (gitignored) and fill in values. All variables are optional:
# with everything blank, the app runs on keyless public services.

# Basemap (MapTiler). Get a key at https://cloud.maptiler.com/account/keys/
# and restrict it to your domains in the MapTiler dashboard. NEXT_PUBLIC_ values
# are inlined into the browser bundle, so this key is public by design.
# Blank = keyless CARTO Positron basemap.
NEXT_PUBLIC_MAPTILER_API_KEY=

# Optional MapTiler map ID (positron, dataviz, streets-v2, basic-v2). Blank = positron.
NEXT_PUBLIC_MAPTILER_STYLE_ID=

# TomTom API key for routing and geocoding. Get a key at https://developer.tomtom.com/
TOMTOM_API_KEY=

# Gemini API key for routing and geocoding. Get a key at https://developer.tomtom.com/
GEMINI_API_KEY=